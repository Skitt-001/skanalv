# ============================================================
# ENVIRONMENT CONFIGURATION - COPY TO .env FOR LOCAL DEVELOPMENT
# ============================================================
# IMPORTANT: Never commit the actual .env file to version control
# This file shows the required variables and their purposes

# EmailJS Configuration (These are PUBLIC keys - safe to expose)
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# Google reCAPTCHA (Site key is PUBLIC - safe to expose)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

